# Copy to .env in this directory (11_docker) and adjust secrets.
# sqlcmd and lab scripts load the same variables.

MSSQL_SA_PASSWORD=YourStrong!Passw0rd
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_USER=sa
# Keep this as SnowConvertStressDB unless you know you need another default; lab scripts 20–22 connect via master + USE.
MSSQL_DB=SnowConvertStressDB

# If sqlcmd never connects: (1) Docker Desktop → Settings → Resources → increase disk image size;
#   run `docker system prune -af` if you see "no space left on device" in compose logs.
# (2) Optional override: SQLCMD_SERVER=host,port (e.g. host.docker.internal,1433).
