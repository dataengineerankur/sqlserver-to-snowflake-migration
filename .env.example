# ─────────────────────────────────────────────────────────────────────────────
# .env.example  —  copy to .env and fill in your values
# Never commit .env — it is gitignored
# ─────────────────────────────────────────────────────────────────────────────

# ── Snowflake ─────────────────────────────────────────────────────────────────
# Account identifier format: <org>-<account>  e.g. myorg-myaccount
SNOWFLAKE_ACCOUNT=your_org-your_account
SNOWFLAKE_USER=your_snowflake_user
SNOWFLAKE_PASSWORD=your_snowflake_password
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=WH_MSSQL_MIGRATION
SNOWFLAKE_DATABASE=MSSQL_MIGRATION_LAB

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_PROFILE=your_aws_profile             # matches a profile in ~/.aws/credentials
# -- or use access keys directly (required for Airbyte S3 destination) --
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# ── S3 buckets (created by CDK / Terraform) ───────────────────────────────────
DMS_BUCKET=your-dms-landing-bucket
GLUE_BUCKET=your-glue-scripts-bucket

# ── SQL Server (local Docker or RDS) ─────────────────────────────────────────
MSSQL_HOST=host.docker.internal
MSSQL_PORT=14433  # use actual mapped port
MSSQL_USER=sa
MSSQL_PASSWORD=your_strong_sa_password   # must meet SQL Server complexity rules
MSSQL_DB=SnowConvertStressDB

# ── Airbyte (if using Airbyte instead of / alongside DMS) ────────────────────
AIRBYTE_URL=http://localhost:8000
AIRBYTE_USERNAME=airbyte
AIRBYTE_PASSWORD=password

# ── Airflow ───────────────────────────────────────────────────────────────────
AIRFLOW_UID=50000                        # run: id -u  on Linux; use 50000 on macOS
